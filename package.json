{
  "name": "dsh-closure-pet-overlay",
  "version": "0.2.3",
  "description": "可露希尔桌宠 · 桌面浮窗版：随 DSH 启停的透明置顶窗口，可跨屏自由拖动、点击穿透、右键设置，并在 AI 运行/谷价时给出提示",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "overlay",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/loffeat/dsh-closure-pet-overlay"
  },
  "license": "MIT"
}
